<div id="section_{{ section.id }}">

    <div class="devCustomHeader">    
        <div class="sectionWrapper">
            <div class="headerWrap">

                {% if section.settings.image1 != blank %}
                    <div class="leftImage">
                        <img src="{{ section.settings.image1 | img_url: 'master' }}">
                    </div>
                {% endif %}

                {% if section.settings.text1 != blank %}
                    <div class="centerContent">
                    {{ section.settings.text1 }}
                    </div>
                {% endif %}

                {% if section.settings.btnLink1 != blank %}
                    <div class="rightContent">
                            <a href="{{ section.settings.btnLink1 }}" class="headerButton" style="color: {{ section.settings.btnColor1 }};">
                                {{ section.settings.btnLabel1 }} {% render 'rightArrow' %}
                            </a>
                    </div>
                {% endif %}   
            </div>  

            <div class="mobileHeaderWrap">
                <div class="mobileInnerWrapper">
                    <div class="menuIcon">
                        <div class="hamburgerIcon">{% render 'hamburgerIcon' %}</div>
                        <div class="closeIcon">{% render 'closeIcon' %}</div>
                    </div>

                    {% if section.settings.image1 != blank %}
                        <div class="leftImage">
                            <img src="{{ section.settings.image1 | img_url: 'master' }}">
                        </div>
                    {% endif %}
                </div>

                <div class="mobileCollapContent">
                    {% if section.settings.text1 != blank %}
                        <div class="centerContent">
                        {{ section.settings.text1 }}
                        </div>
                    {% endif %}

                    {% if section.settings.btnLink1 != blank %}
                        <div class="rightContent">
                                <a href="{{ section.settings.btnLink1 }}" class="headerButton" style="color: {{ section.settings.btnColor1 }};">
                                    {{ section.settings.btnLabel1 }} {% render 'rightArrow' %}
                                </a>
                        </div>
                    {% endif %}
                </div>
            </div>



        </div>    
    </div>

    <div class="sectionWrapper">

        {% if section.settings.image != blank %}
            <div class="sectionImage">
                <img{% if section.settings.mobimage != blank %} class="deskImage"{% endif %} src="{{ section.settings.image | img_url: 'master' }}">
                {% if section.settings.mobimage != blank %}<img class="mobileImage" src="{{ section.settings.mobimage | img_url: 'master' }}">{% endif %}
            </div>
        {% endif %}

        {% if section.settings.heading != blank or section.settings.text != blank or section.settings.btnLink != blank %}
            <div class="bannerContent">
                {% if section.settings.heading != blank %}<h1>{{ section.settings.heading }}</h1>{% endif %}
                {% if section.settings.text != blank %}<div class="text">{{ section.settings.text }}</div>{% endif %}
                {% if section.settings.btnLink != blank %}
                    <a href="{{ section.settings.btnLink }}" class="btn">
                        {{ section.settings.btnLabel }} {% render 'rightArrow' %}
                    </a>
                {% endif %}
            </div>
        {% endif %}

        {% if section.settings.btnLink != blank %}
            <div class="bannerAbsBtn">                
                <a href="{{ section.settings.btnLink }}" class="btn">
                    {{ section.settings.btnLabel }} {% render 'rightArrow' %}
                </a>                
            </div>
        {% endif %}
    </div>

    {% if section.settings.bottomtext != blank %}
        <div class="bottomBar">
            <div{% if section.settings.bottomtextMob != blank %} class="deskContent"{% endif %}>{{ section.settings.bottomtext }}</div>
            {% if section.settings.bottomtextMob != blank %}<div class="mobileContent">{{ section.settings.bottomtextMob }}</div>{% endif %}
        </div>
    {% endif %}
</div>


{% style %}

    #section_{{ section.id }} .bannerContent,  #section_{{ section.id }} .bottomBar {
        color: {{ section.settings.textColor }};
    } 

    #section_{{ section.id }} .bottomBar {
        background-color: {{ section.settings.barBgColor }};
    }

    #section_{{ section.id }} .btn {
        background-color: {{ section.settings.btnBgColor }};
        background-image: linear-gradient(
            to right,
            {{ section.settings.btnHoverBg }},
            {{ section.settings.btnHoverBg }}
        );
        color:{{ section.settings.btnColor }};
        background-repeat: no-repeat;
        background-size: 0% 100%;
        transition: background-size 0.5s ease;
    }

    #section_{{ section.id }} .btn svg path {
        fill: {{ section.settings.btnColor }} !important;
    }    

    #section_{{ section.id }} .btn:hover {
        background-size: 100% 100%;
    }


    #section_{{ section.id }} .btn:hover {
        color: {{ section.settings.btnHoverColor }} !important;
    }    

    #section_{{ section.id }} .btn:hover svg path {
        fill: {{ section.settings.btnHoverColor }} !important;
    }  
    
    
    #section_{{ section.id }} .devCustomHeader .sectionWrapper {
        background-color: {{ section.settings.bgColor1 }};
    }

    #section_{{ section.id }} .centerContent {
        color: {{ section.settings.textColor1 }};
    } 

    #section_{{ section.id }} .headerButton {
        background-color: {{ section.settings.btnBgColor1 }};
        background-image: linear-gradient(
            to right,
            {{ section.settings.btnHoverBg1 }},
            {{ section.settings.btnHoverBg1 }}
        );
        background-repeat: no-repeat;
        background-size: 0% 100%;
        transition: background-size 0.5s ease;
    }

    #section_{{ section.id }} .headerButton:hover {
        background-size: 100% 100%;
    }


    #section_{{ section.id }} .headerButton:hover {
        color: {{ section.settings.btnHoverColor1 }} !important;
    }    

    #section_{{ section.id }} .headerButton:hover svg path {
        fill: {{ section.settings.btnHoverColor1 }} !important;
    }  



{% endstyle %}


<script>
    document.addEventListener('DOMContentLoaded', function () {

        const menuIcon = document.querySelector('.menuIcon');
        const mobileHeader = document.querySelector('.mobileHeaderWrap');
        const content = document.querySelector('.mobileCollapContent');

        menuIcon.addEventListener('click', function () {


            // Add/remove active class
            menuIcon.classList.toggle('active');
            mobileHeader.classList.toggle('active');

            if (content.style.height === '0px' || !content.style.height) {
                content.style.height = content.scrollHeight + 'px';
            } else {
                content.style.height = '0px';
            }

        });

    });

</script>


