<div id="section_{{ section.id }}">
    <div class="sectionWrapper">

        <div class="mainWrap">
            {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}

            <div class="devGridWrapper">
                {% for block in section.blocks %}
                    {% assign product = block.settings.product %}
                    <div id="block{{ block.id }}" class="product">
                        {% if block.settings.product != blank %}
                                <img src="{{ product.featured_image | img_url: 'master' }}">
                        {% endif %}

                        <div class="devQuickViewBtn" data-popup="quickView-{{ block.id }}">
                            {% render 'plusIcon' %}
                        </div>

                      
                            {% if product != blank %}

                                <div
                                id="quickView-{{ block.id }}"
                                class="devQuickView"
                                >

                                    <div class="devQuickViewPopup">

                                            <button type="button" class="devQuickViewClose">
                                                {% render 'closeIcon' %}
                                            </button>


                                            <div class="devQuickViewInner">

                                                <div class="devInfoWrap">

                                                    <div class="devQuickViewImage">

                                                        {% if product.featured_image %}
                                                            <img
                                                                src="{{ product.featured_image | image_url: width: 600 }}"
                                                                alt="{{ product.title | escape }}"
                                                            >
                                                        {% endif %}

                                                    </div>

                                                    <div class="devQuickViewInfo">
                                                        <h2>{{ product.title }}</h2>

                                                        <div class="devQuickViewPrice">
                                                            {% if product.compare_at_price > product.price %}
                                                                <span class="sale-price">
                                                                {{ product.price | money }}
                                                                </span>

                                                                <span class="compare-price">
                                                                {{ product.compare_at_price | money }}
                                                                </span>

                                                            {% else %}
                                                                {{ product.price | money }}
                                                            {% endif %}
                                                        </div>

                                                        {% if product.description != blank %}
                                                            <div class="devQuickViewDescription">
                                                                {{ product.description }}
                                                            </div>
                                                        {% endif %}


                                                </div>

                                            </div>


                                                {% if product.has_only_default_variant == false %}

                                                <div class="devVariantWrapper">

                                                    {% for option in product.options_with_values %}

                                                    <div class="devVariantOption">

                                                        <label class="devVariantLabel">
                                                        {{ option.name }}
                                                        </label>

                                                        {% if option.name == 'Color' or option.name == 'Colour' %}

                                                            <div class="devColorOptions">

                                                                {% for value in option.values %}

                                                                <button
                                                                    type="button"
                                                                    class="devColorOption {% if forloop.first %}is-selected{% endif %}"
                                                                    data-option-index="{{ forloop.parentloop.index0 }}"
                                                                    data-value="{{ value | escape }}" style="border-left: 4.84px solid {{ value | escape }};"
                                                                >
                                                                    {{ value }}
                                                                </button>

                                                                {% endfor %}

                                                            </div>

                                                        {% else %}

                                                            <div
                                                                class="devVariantSelect"
                                                                data-option-index="{{ forloop.index0 }}"
                                                            >

                                                                <div class="devVariantSelectTrigger">
                                                                    <span class="devSelectedValue">
                                                                        {{ section.settings.defOption }}
                                                                    </span>

                                                                    <span class="devSelectArrow">{% render 'chevrondownIcon' %}</span>
                                                                </div>

                                                                <div class="devVariantOptions">

                                                                    {% for value in option.values %}

                                                                        <div
                                                                            class="devVariantOption"
                                                                            data-value="{{ value | escape }}"
                                                                        >
                                                                            {{ value }}
                                                                        </div>

                                                                    {% endfor %}

                                                                </div>

                                                            </div>


                                                        {% endif %}

                                                </div>

                                                {% endfor %}

                                            </div>

                                            {% endif %}

                                           <script type="application/json" class="devProductVariants">
                                            {{ product.variants | json }}
                                            </script>

                                            <form action="/cart/add" method="post" class="devAddToCartForm">

                                                <input
                                                    type="hidden"
                                                    name="id"
                                                    value="{{ product.selected_or_first_available_variant.id }}"
                                                    class="devVariantId"
                                                >

                                                <input
                                                    type="hidden"
                                                    name="quantity"
                                                    value="1"
                                                    class="devHiddenQuantity"
                                                >

                                                <button
                                                    type="submit"
                                                    class="devAddToCart" style="color: {{ section.settings.btnColor1 }};"
                                                >
                                                    {{ section.settings.cartBtn }} {% render 'rightArrow' %}
                                                </button>

                                            </form>




                                        </div>

                                    </div>

                                </div>

                            {% endif %}





                    </div>

                {% endfor %}

            </div>



            
        </div>

    </div>
</div>

{% style %}
    {% for block in section.blocks %}
        #section_{{ section.id }} #block{{ block.id }} .devQuickViewBtn {
            left:unset;
            bottom: unset;
            top:{{ block.settings.top }}px;
            right:{{ block.settings.right }}px;
        }
    {% endfor %}

    #section_{{ section.id }} .devAddToCart {
        background-color: {{ section.settings.btnBgColor1 }};
        background-image: linear-gradient(
            to right,
            {{ section.settings.btnHoverBg1 }},
            {{ section.settings.btnHoverBg1 }}
        );
        background-repeat: no-repeat;
        background-size: 0% 100%;
        transition: background-size 0.5s ease;
    }

    #section_{{ section.id }} .devAddToCart:hover {
        background-size: 100% 100%;
    }


    #section_{{ section.id }} .devAddToCart:hover {
        color: {{ section.settings.btnHoverColor1 }} !important;
    }    

    #section_{{ section.id }} .devAddToCart:hover svg path {
        fill: {{ section.settings.btnHoverColor1 }} !important;
    }  


{% endstyle %}



<script>
    document.addEventListener('DOMContentLoaded', function () {

        /* ==========================================
        OPEN QUICK VIEW
        ========================================== */

        document.querySelectorAll('.devQuickViewBtn').forEach(function (button) {

            button.addEventListener('click', function () {

                const popupId = button.getAttribute('data-popup');
                const popup = document.getElementById(popupId);

                if (!popup) return;

                popup.classList.add('active');
                document.body.style.overflow = 'hidden';

                setupVariants(popup);
            });

        });


        /* ==========================================
        CLOSE QUICK VIEW
        ========================================== */

        document.querySelectorAll('.devQuickViewClose').forEach(function (button) {

            button.addEventListener('click', function () {

                const popup = button.closest('.devQuickView');

                if (!popup) return;

                popup.classList.remove('active');
                document.body.style.overflow = '';

            });

        });


        /* ==========================================
        CLOSE ON OVERLAY
        ========================================== */

        document.querySelectorAll('.devQuickViewOverlay').forEach(function (overlay) {

            overlay.addEventListener('click', function () {

                const popup = overlay.closest('.devQuickView');

                if (!popup) return;

                popup.classList.remove('active');
                document.body.style.overflow = '';

            });

        });


        /* ==========================================
        ESC
        ========================================== */

        document.addEventListener('keydown', function (event) {

            if (event.key === 'Escape') {

                document.querySelectorAll('.devQuickView.active').forEach(function (popup) {
                    popup.classList.remove('active');
                });

                document.body.style.overflow = '';

            }

        });


        /* ==========================================
        VARIANT SETUP
        ========================================== */

        function setupVariants(popup) {

            // Prevent adding the same event listeners multiple times
            if (popup.dataset.variantReady === 'true') return;

            popup.dataset.variantReady = 'true';

            const variantJSON = popup.querySelector('.devProductVariants');
            const variantInput = popup.querySelector('.devVariantId');

            if (!variantJSON || !variantInput) {
                console.log('Variant JSON or variant input not found');
                return;
            }

            let variants = [];

            try {
                variants = JSON.parse(variantJSON.textContent.trim());
            } catch (error) {
                console.log('Variant JSON error:', error);
                return;
            }

            console.log('Product variants:', variants);


            /* ==========================================
            COLOR BUTTONS
            ========================================== */

            popup.querySelectorAll('.devColorOption').forEach(function (button) {

                button.addEventListener('click', function () {

                    const optionIndex = parseInt(
                        button.dataset.optionIndex,
                        10
                    );

                    const value = button.dataset.value;

                    // Remove active from same option
                    popup.querySelectorAll(
                        '.devColorOption[data-option-index="' + optionIndex + '"]'
                    ).forEach(function (item) {
                        item.classList.remove('is-selected');
                    });

                    button.classList.add('is-selected');

                    const colorOptions = button.closest('.devColorOptions');

                    if (colorOptions) {
                        const buttons = colorOptions.querySelectorAll('.devColorOption');

                        colorOptions.classList.toggle(
                            'second-selected',
                            button === buttons[1]
                        );
                    }


                    // Store selected value
                    button.closest('.devVariantOption').dataset.selectedValue = value;

                    findVariant(popup, variants, variantInput);

                });

            });


            /* ==========================================
            DROPDOWN TRIGGER
            ========================================== */

            popup.querySelectorAll('.devVariantSelect').forEach(function (select) {

                const trigger = select.querySelector('.devVariantSelectTrigger');

                if (!trigger) return;

                trigger.addEventListener('click', function (event) {

                    event.stopPropagation();

                    popup.querySelectorAll('.devVariantSelect').forEach(function (other) {

                        if (other !== select) {
                            other.classList.remove('active');
                        }

                    });

                    select.classList.toggle('active');

                });


                /* ==========================================
                DROPDOWN OPTIONS
                ========================================== */

                select.querySelectorAll('.devVariantOptions .devVariantOption')
                    .forEach(function (option) {

                        option.addEventListener('click', function (event) {

                            event.stopPropagation();

                            const value = option.dataset.value;

                            const selectedText =
                                select.querySelector('.devSelectedValue');

                            if (selectedText) {
                                selectedText.textContent = value;
                            }

                            // Save selected value on dropdown
                            select.dataset.selectedValue = value;

                            select.classList.remove('active');

                            findVariant(popup, variants, variantInput);

                        });

                    });

            });


            /* ==========================================
            FIND MATCHING VARIANT
            ========================================== */

            function findVariant(popup, variants, variantInput) {

                const selectedOptions = [];


                // Get color selections
                popup.querySelectorAll('.devColorOption.is-selected')
                    .forEach(function (button) {

                        const index = parseInt(
                            button.dataset.optionIndex,
                            10
                        );

                        selectedOptions[index] = button.dataset.value;

                    });


                // Get dropdown selections
                popup.querySelectorAll('.devVariantSelect')
                    .forEach(function (select) {

                        const index = parseInt(
                            select.dataset.optionIndex,
                            10
                        );

                        if (select.dataset.selectedValue) {
                            selectedOptions[index] =
                                select.dataset.selectedValue;
                        }

                    });


                console.log('Selected options:', selectedOptions);


                /* ==========================================
                FIND VARIANT
                ========================================== */

                const matchingVariant = variants.find(function (variant) {

                    return selectedOptions.every(function (value, index) {

                        if (!value) return true;

                        return variant['option' + (index + 1)] === value;

                    });

                });


                console.log('Matching variant:', matchingVariant);


                if (!matchingVariant) {

                    console.log('No matching variant found');

                    return;
                }


                /* ==========================================
                UPDATE HIDDEN VARIANT ID
                ========================================== */

                variantInput.value = matchingVariant.id;

                console.log(
                    'Cart variant ID:',
                    matchingVariant.id
                );


                /* ==========================================
                ENABLE / DISABLE ADD TO CART
                ========================================== */

                const addButton =
                    popup.querySelector('.devAddToCart');

                if (addButton) {

                    addButton.disabled = !matchingVariant.available;

                }

            }

        }



            // ==========================================
            // SIZE VARIANT CLICK EVENT
            // ==========================================

            document.querySelectorAll('.devVariantSelect').forEach(function (select) {

                const trigger = select.querySelector('.devVariantSelectTrigger');
                const selected = select.querySelector('.devSelectedValue');
                const options = select.querySelectorAll('.devVariantOption');

                if (!trigger || !selected) return;


                trigger.addEventListener('click', function (e) {

                    e.stopPropagation();

                    // Close other dropdowns
                    document.querySelectorAll('.devVariantSelect').forEach(function (item) {

                        if (item !== select) {

                            item.classList.remove('is-open');

                            const otherContent = item.querySelector('.devVariantOptions');

                            if (otherContent) {
                                otherContent.style.height = '0px';
                            }

                        }

                    });


                    // Open / close current dropdown
                    select.classList.toggle('is-open');

                    const content = select.querySelector('.devVariantOptions');

                    if (!content) return;


                    if (select.classList.contains('is-open')) {

                        // OPEN
                        content.style.height = content.scrollHeight + 'px';

                    } else {

                        // CLOSE
                        content.style.height = '0px';

                    }

                });


                // ==========================================
                // SIZE OPTIONS
                // ==========================================

                options.forEach(function (option) {

                    option.addEventListener('click', function (e) {

                        e.stopPropagation();

                        const value = this.dataset.value;

                        // Show selected value
                        selected.textContent = value;

                        // Save selected value
                        select.dataset.selectedValue = value;

                        // Close dropdown
                        select.classList.remove('is-open');

                        // Reset dropdown height
                        const content = select.querySelector('.devVariantOptions');

                        if (content) {
                            content.style.height = '0px';
                        }

                        // Remove size error if user selects size
                        const popup = select.closest('.devQuickView');

                        if (popup) {

                            const error = popup.querySelector('.devSizeError');

                            if (error) {
                                error.remove();
                            }

                        }


                        // Shopify variant selection event
                        select.dispatchEvent(
                            new CustomEvent('devVariantChange', {
                                bubbles: true,
                                detail: {
                                    optionIndex: select.dataset.optionIndex,
                                    value: value
                                }
                            })
                        );

                    });

                });

            });


            // ==========================================
            // CLICK OUTSIDE = CLOSE
            // ==========================================

            document.addEventListener('click', function () {

                document.querySelectorAll('.devVariantSelect').forEach(function (select) {

                    select.classList.remove('is-open');

                    const content = select.querySelector('.devVariantOptions');

                    if (content) {
                        content.style.height = '0px';
                    }

                });

            });



        // ==========================================
        // ADD TO CART VIA AJAX (NO REDIRECT)
        // ==========================================

        document.querySelectorAll('.devAddToCartForm').forEach(function (form) {

            form.addEventListener('submit', function (e) {

                e.preventDefault(); // redirect rokne ke liye ye sabse zaroori hai

                const popup = form.closest('.devQuickView');
                if (!popup) return;

                // Size validation (agar size dropdown maujood hai)
                const sizeSelect = Array.from(
                    popup.querySelectorAll('.devVariantSelect')
                ).find(function (select) {
                    const wrapper = select.closest('.devVariantOption');
                    if (!wrapper) return false;
                    const label = wrapper.querySelector('.devVariantLabel');
                    return label && label.textContent.trim().toLowerCase() === 'size';
                });

                if (sizeSelect && !sizeSelect.dataset.selectedValue) {

                    const oldError = popup.querySelector('.devSizeError');
                    if (oldError) oldError.remove();

                    const error = document.createElement('div');
                    error.className = 'devSizeError';
                    error.textContent = 'Please select a size.';
                    sizeSelect.insertAdjacentElement('afterend', error);

                    return; // yahan se aage nahi jayega
                }

                const addButton = form.querySelector('.devAddToCart');
                const formData = new FormData(form);

                if (addButton) {
                    addButton.disabled = true;
                    addButton.classList.add('is-loading');
                }

                fetch('/cart/add.js', {
                    method: 'POST',
                    body: formData
                })
                .then(function (response) {
                    if (!response.ok) throw new Error('Add to cart failed');
                    return response.json();
                })
                .then(function (data) {
                    console.log('Added to cart:', data);

                    // Cart drawer/count update karne ke liye event trigger
                    document.dispatchEvent(new CustomEvent('cart:updated', {
                        bubbles: true,
                        detail: data
                    }));

                    // Button text change
                    if (addButton) {

                        const originalText = addButton.innerHTML;

                        addButton.innerHTML = 'Added to Cart';

                        setTimeout(function () {
                            addButton.innerHTML = originalText;
                            addButton.disabled = false;
                        }, 2000); // after2 second, original text
                    }
                })
                .catch(function (error) {
                    console.log('Add to cart error:', error);
                })
                .finally(function () {
                    if (addButton) {
                        addButton.classList.remove('is-loading');
                    }
                });

            });

        });


    });

</script>



{% schema %}
    {
    "name": "Grid",
    "tag": "section",
    "class": "section devProductGrid",
    "settings": [
            {
                "type": "text",
                "id": "heading",
                "label": "Heading"
            },
            {
                "type": "text",
                "id": "cartBtn",
                "label": "Add to cart",
                "default": "Add to cart"
            }, 
            {
                "type": "text",
                "id": "defOption",
                "label": "Choose your size",
                "default": "Choose your size"
            },   
            {
                "type": "header",
                "content": "Add to cart button"
            },              
            {
                "type": "color",
                "id": "btnBgColor1",
                "label": "Button background color",
                "default": "#000"
            },   
            {
                "type": "color",
                "id": "btnColor1",
                "label": "Button color",
                "default": "#fff"
            },     
            {
                "type": "color",
                "id": "btnHoverBg1",
                "label": "Button hover background color",
                "default": "#FFF544"
            },   
            {
                "type": "color",
                "id": "btnHoverColor1",
                "label": "Button hover color",
                "default": "#000"
            },                             
        ],
    "blocks": [
        {
        "type": "product",
        "name": "Product",
        "settings": [
            {
                "type": "product",
                "id": "product",
                "label": "Product"
            },
            {
                "type": "header",
                "content": "Adjust quickview button position"
            },            
            {
                "type": "text",
                "id": "top",
                "label": "Top",
                "default": "50",
                "info": "px"
            },
            {
                "type": "text",
                "id": "right",
                "label": "Right",
                "default": "50",
                "info": "px"
            }                                   
        ]
        }
    ],        
    "presets": [
        {
        "name": "Grid",
        }
    ]

    }
{% endschema %}